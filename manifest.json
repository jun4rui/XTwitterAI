{
  "manifest_version": 3,
  "name": "X Tweet Translator",
  "version": "3.4",
  "description": "Translate English tweets to Chinese on X (Twitter) using Chrome's built-in Translator API",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Tweet Translator"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}